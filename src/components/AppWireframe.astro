---
// What stands on the GlassPhone's screen: the app's icon and name under the island, and the campus
// as the app maps it, engraved in the glass, with event pins on their places. All of it is the app's:
//   icon    the iOS app icon (01 Brand/neoQuad Brand Resources/iOS app icon)
//   name    with chevron.right, the app's row disclosure
//   map     SBCC from the same OpenStreetMap footprints the app's places come from, north up as the
//           app's campus camera is; drawn by tools/campus-map.py into src/data/campus-map.json
//   pins    PinCore (Views/EventPinView.swift): a 40 pt white disc holding a 34 pt photo, a 3 pt
//           white ring and a soft shadow; a live event adds a red ring that pulses outward. Each
//           stands on its place (SBCCBuildings.swift) and shows that place's photo (BuildingPhoto_*).
// Sizes are in cqw of the phone, on a 402 pt wide screen (1 pt = 0.2488cqw). It is decoration;
// the phone is aria-hidden.
import { Image } from 'astro:assets';
import Symbol from './Symbol.astro';
import map from '../data/campus-map.json';
import icon from '../assets/app/icon.png';
import overlook from '../assets/app/pins/overlook.jpg';
import garden from '../assets/app/pins/garden.jpg';
import pride from '../assets/app/pins/pride.jpg';

const pins = [
  { photo: garden, at: map.pins.Garden },
  { photo: overlook, at: map.pins.Overlook },
  { photo: pride, at: map.pins.Pride, live: true },
];
---

<div class="app">
  <svg class="map" viewBox={`0 0 ${map.width} ${map.height}`} aria-hidden="true">
    <path class="map-shore" d={map.shore} />
    <path class="map-streets" d={map.streets} />
    <path class="map-walks" d={map.walks} />
    <path class="map-buildings" d={map.buildings} />
  </svg>

  <div class="app-id">
    <Image class="app-icon" src={icon} alt="" width={144} height={144} format="webp" />
    <span class="app-name">neoQuad<Symbol name="chevron.right" /></span>
  </div>

  {
    pins.map((pin, i) => (
      <span class:list={['pin', pin.live && 'pin--live']} style={`left:${pin.at.x}%;top:${pin.at.y}%;--n:${i}`}>
        <Image src={pin.photo} alt="" width={96} height={96} format="webp" />
      </span>
    ))
  }
</div>

<style>
  .app {
    --pt: 0.2488cqw;
    position: absolute;
    inset: 0;
    color: var(--white);
    font-family: -apple-system, BlinkMacSystemFont, var(--sans);
  }

  /* The map: hairlines engraved in the glass, buildings brightest, walkways quietest. It fades out
     toward the pane's edges and under the icon, so nothing meets it hard. */
  .map {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--white);
    stroke-linejoin: round;
    stroke-linecap: round;
    -webkit-mask:
      linear-gradient(180deg, transparent 12%, #000 26%, #000 64%, transparent 80%),
      linear-gradient(90deg, transparent 2%, #000 14%, #000 86%, transparent 98%);
    -webkit-mask-composite: source-in;
    mask:
      linear-gradient(180deg, transparent 12%, #000 26%, #000 64%, transparent 80%) intersect,
      linear-gradient(90deg, transparent 2%, #000 14%, #000 86%, transparent 98%);
  }

  .map path {
    vector-effect: non-scaling-stroke;
  }

  .map-buildings {
    fill: rgba(255, 255, 255, 0.07);
    stroke-opacity: 0.6;
    stroke-width: 0.75;
  }

  .map-walks {
    stroke-opacity: 0.22;
    stroke-width: 0.6;
  }

  .map-streets {
    stroke-opacity: 0.34;
    stroke-width: 1.25;
  }

  .map-shore {
    stroke-opacity: 0.5;
    stroke-width: 1;
  }

  /* Icon and name, centred under the island. */
  .app-id {
    position: absolute;
    top: 15.5cqw;
    left: 0;
    right: 0;
    display: grid;
    justify-items: center;
    gap: 2.4cqw;
  }

  .app-icon {
    width: 12cqw;
    height: 12cqw;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0.6cqw 2cqw rgba(20, 16, 30, 0.16);
  }

  .app-name {
    display: flex;
    align-items: center;
    gap: 0.9cqw;
    font-size: 3.7cqw;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-shadow: 0 0.2cqw 1cqw rgba(20, 16, 30, 0.24);
  }

  .app-name :global(.symbol) {
    font-size: 2.6cqw;
    opacity: 0.72;
  }

  /* A pin, as PinCore draws it. */
  .pin {
    position: absolute;
    width: calc(40 * var(--pt));
    height: calc(40 * var(--pt));
    margin: calc(-20 * var(--pt));
    border-radius: 50%;
    background: var(--white);
    box-shadow: 0 calc(2 * var(--pt)) calc(12 * var(--pt)) rgba(0, 0, 0, 0.22);
  }

  .pin img {
    position: absolute;
    inset: calc(3 * var(--pt));
    width: calc(34 * var(--pt));
    height: calc(34 * var(--pt));
    border-radius: 50%;
    object-fit: cover;
  }

  /* Live: a red ring 3 pt outside the disc grows by 22 pt and fades, every 2.2 s, as in the app. */
  .pin--live::after {
    content: '';
    position: absolute;
    inset: calc(-3 * var(--pt));
    border-radius: 50%;
    box-shadow: inset 0 0 0 calc(2.5 * var(--pt)) rgba(255, 59, 48, 0.45);
    animation: live 2200ms cubic-bezier(0, 0, 0.58, 1) infinite;
  }

  @keyframes live {
    to {
      opacity: 0;
      transform: scale(1.48);
    }
  }

  /* Arriving, once the phone has risen: the map fades up, then the pins settle onto it in turn. */
  @keyframes map-in {
    from {
      opacity: 0;
    }
  }

  @keyframes pin-in {
    from {
      opacity: 0;
      transform: translateY(calc(-8 * var(--pt))) scale(0.9);
    }
  }

  :global(html[data-enter]) .map {
    animation: map-in 900ms var(--ease-out) backwards;
    animation-delay: var(--t0, 1200ms);
  }

  :global(html[data-enter]) .pin {
    animation: pin-in 520ms var(--ease-out) backwards;
    animation-delay: calc(var(--t0, 1200ms) + 420ms + var(--n) * 60ms);
  }

  /* Reduced motion: the pins fade in where they stand; the ring stays and only breathes. */
  @media (prefers-reduced-motion: reduce) {
    :global(html[data-enter]) .pin {
      animation-name: map-in;
    }

    .pin--live::after {
      animation: breathe 2200ms ease-in-out infinite alternate;
    }

    @keyframes breathe {
      to {
        opacity: 0.4;
      }
    }
  }
</style>
