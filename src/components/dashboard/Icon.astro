export type IconName = keyof typeof paths | 'appearance';

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg class:list={['icon', className]} viewBox="0 0 24 24" aria-hidden="true">
  {
    name === 'appearance' ? (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" />
      </>
    ) : (
      paths[name].map((d) => <path d={d} />)
    )
  }
</svg>

<style>
  .icon {
    width: 1em;
    height: 1em;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
