---
// The staff dashboard, drawn in HTML from one set of sample figures (dashboard/sample.ts) and switched by tabs.
// The screen is laid out on the staff site's own 1862 x 1086 grid and scaled to any width:
// every length is `calc(var(--u) * <px on that grid>)`, so it stays sharp at every size.
import Sidebar from './dashboard/Sidebar.astro';
import Insights from './dashboard/Insights.astro';
import Events from './dashboard/Events.astro';
import NewEvent from './dashboard/NewEvent.astro';

const views = [
  { key: 'insights', label: 'Insights', view: Insights, item: 0 },
  { key: 'events', label: 'Events', view: Events, item: 3 },
  { key: 'new-event', label: 'New event', view: NewEvent, item: 4 },
];
---

<div class="dash" data-dash data-active={views[0].key} style={`--at:${views[0].item}`}>
  <div class="dash-tabs" role="tablist" aria-label="Dashboard screens" style={`--count:${views.length}`}>
    {
      views.map((view, i) => (
        <button
          role="tab"
          type="button"
          id={`dash-tab-${view.key}`}
          aria-controls={`dash-panel-${view.key}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-key={view.key}
          data-index={i}
          data-item={view.item}
        >
          {view.label}
        </button>
      ))
    }
    <span class="dash-pill" aria-hidden="true">{views.map((view) => <span>{view.label}</span>)}</span>
  </div>

  <div class="dash-stage">
    <div class="dash-track">
      <div class="dash-screen">
        <Sidebar />
        {
          views.map(({ key, view: View }, i) => (
            <div
              class="dash-panel"
              role="tabpanel"
              id={`dash-panel-${key}`}
              aria-labelledby={`dash-tab-${key}`}
              data-key={key}
              data-current={i === 0 ? '' : undefined}
              aria-hidden={i === 0 ? 'false' : 'true'}
              inert={i === 0 ? undefined : true}
            >
              <View />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<script>
  const init = () => {
    document.querySelectorAll<HTMLElement>('[data-dash]:not([data-ready])').forEach((dash) => {
      dash.dataset.ready = '';
      const tabs = [...dash.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const panels = [...dash.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
      const list = dash.querySelector<HTMLElement>('.dash-tabs')!;

      const select = (tab: HTMLButtonElement, focus = false) => {
        const key = tab.dataset.key!;
        dash.dataset.active = key;
        dash.style.setProperty('--at', tab.dataset.item!);
        list.style.setProperty('--index', tab.dataset.index!);
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
        });
        panels.forEach((p) => {
          const on = p.dataset.key === key;
          p.toggleAttribute('data-current', on);
          p.toggleAttribute('inert', !on);
          p.setAttribute('aria-hidden', String(!on));
        });
        if (focus) tab.focus();
      };

      const keys: Record<string, (i: number) => number> = {
        ArrowRight: (i) => (i + 1) % tabs.length,
        ArrowLeft: (i) => (i - 1 + tabs.length) % tabs.length,
        Home: () => 0,
        End: () => tabs.length - 1,
      };

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(tab));
        tab.addEventListener('keydown', (event) => {
          const to = keys[event.key];
          if (!to) return;
          event.preventDefault();
          select(tabs[to(i)], true);
        });
      });
    });
  };

  document.addEventListener('astro:page-load', init);
</script>

<style>
  .dash-tabs {
    --index: 0;
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--count), 1fr);
    width: fit-content;
    height: 48px;
    margin-inline: auto;
    border-radius: 999px;
    background: var(--mist);
    font-size: 0.9375rem;
    font-weight: 500;
    transition: transform 160ms var(--ease-out);
  }

  /* The whole control gives under the finger, so a press feels heard before the pill moves. */
  .dash-tabs:has(button:active) {
    transform: scale(0.98);
  }

  .dash-tabs button,
  .dash-pill span {
    display: grid;
    place-items: center;
    padding: 0 clamp(14px, 3.6vw, 26px);
    white-space: nowrap;
  }

  .dash-tabs button {
    appearance: none;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--graphite);
    font: inherit;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Labels dim with opacity, not colour, so the hover change stays on the compositor. */
  .dash-tabs button {
    opacity: 0.62;
    transition: opacity 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .dash-tabs button:hover {
      opacity: 1;
    }
  }

  .dash-pill {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(var(--count), 1fr);
    border-radius: 999px;
    background: var(--graphite);
    color: var(--white);
    pointer-events: none;
    --w: calc(100% / var(--count));
    clip-path: inset(
      4px calc(100% - var(--w) * (var(--index) + 1) + 4px) 4px calc(var(--w) * var(--index) + 4px) round 999px
    );
    transition: clip-path 420ms var(--ease-glass);
  }

  /* The frame: one hairline drawn by the frame itself, the screen clipped by the same smoothed corner.
     On a phone the screen is shown at twice the width and pans sideways, so it stays readable. */
  .dash-stage {
    --radius: calc(clamp(12px, 1.8vw, 24px) * var(--corner-reach));
    margin-top: clamp(24px, 3vw, 40px);
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    corner-shape: var(--corner);
    background: var(--d-bg);
    box-shadow: 0 40px 80px -40px rgba(28, 28, 30, 0.28);
  }

  .dash-stage::-webkit-scrollbar {
    display: none;
  }

  .dash-track {
    width: 200%;
    container-type: inline-size;
  }

  @media (min-width: 700px) {
    .dash-stage {
      overflow: hidden;
    }

    .dash-track {
      width: 100%;
    }
  }

  /* The staff site's palette, light mode. */
  .dash {
    --d-bg: #f4f2ee;
    --d-card: #ffffff;
    --d-line: #e3e1dd;
    --d-card-line: #ebe9e6;
    --d-hair: #efeeec;
    --d-field-line: #dcdad6;
    --d-cell-line: #e9e8e4;
    --d-chip-line: #d0d0d0;
    --d-well: #e8e6e2;
    --d-active: #e9e5dd;
    --d-badge: #f1f1f1;
    --d-out: #f8f7f3;
    --d-out-line: #eeede9;
    --d-track: #dbdad6;
    --d-ink: #111111;
    --d-nav: #5f5d59;
    --d-seg: #5c5b57;
    --d-muted: #747474;
    --d-label: #6b6b6b;
    --d-faint: #9b9995;
    --d-day: #555555;
    --d-good: #1e8048;
    --d-bad: #b4372c;
    --d-blue: #1769c2;
    --d-live: #f0284a;
    --d-upcoming: #2f9bf0;
    --d-progress: #34d530;
  }

  .dash-screen {
    --u: calc(100cqw / 1862);
    position: relative;
    aspect-ratio: 1862 / 1086;
    overflow: hidden;
    color: var(--d-ink);
    font-family: var(--sans);
    line-height: 1.25;
    -webkit-font-smoothing: antialiased;
    user-select: none;
    -webkit-user-select: none;
  }

  :global(:where(.dash-screen h4)) {
    margin: 0;
  }

  /* The open screen crossfades; the sidebar stays put, as it does on the staff site. */
  .dash-panel {
    position: absolute;
    inset: 0 0 0 calc(var(--u) * 287.5);
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .dash-panel[data-current] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .dash-tabs,
    .dash-pill {
      transition: none;
    }

    .dash-tabs:has(button:active) {
      transform: none;
    }

    .dash-panel {
      transition-duration: 120ms;
    }
  }
</style>
