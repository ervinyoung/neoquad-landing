---
// A phone made of the hero glass (GlassPane): the photograph shows through it, softened, and a
// Dynamic Island. Whatever stands on its screen is the slot. Sizes are in cqw (percent of the
// phone's width), so the phone can be any size and keep its proportions; the slot can use cqw too.
import GlassPane from './GlassPane.astro';
---

<div class="phone" aria-hidden="true">
  <GlassPane />
  <div class="phone-island"></div>
  <div class="phone-screen"><slot /></div>
</div>

<style>
  .phone {
    --pane-radius: 14.5cqw;
    --pane-frost: 2.4cqw;
    --pane-rim: max(1.5px, 0.36cqw);

    position: relative;
    container-type: inline-size;
    width: 100%;
    /* An iPhone 16 Pro: 71.5 x 149.6 mm. */
    aspect-ratio: 715 / 1496;
  }

  /* The Dynamic Island, a darker drop of the same glass. */
  .phone-island {
    position: absolute;
    top: 4.4cqw;
    left: 37.5cqw;
    width: 25cqw;
    height: 7cqw;
    border-radius: 999px;
    background: rgba(38, 42, 50, 0.58);
  }

  .phone-screen {
    position: absolute;
    inset: 0;
  }
</style>
