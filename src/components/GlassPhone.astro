---
// A phone made of clear Liquid Glass: you see the photograph through it.
// It is only the object: a body, a thicker rim that bends the light, and the Dynamic Island.
// Whatever goes on its screen is the slot. Sizes inside are in cqw (percent of the phone's width),
// so the phone can be any size and keep its proportions.
---

<div class="phone" aria-hidden="true">
  <div class="phone-rim"></div>
  <div class="phone-screen"><slot /></div>
  <div class="phone-island"></div>
</div>

<style>
  .phone {
    position: relative;
    container-type: inline-size;
    width: 100%;
    aspect-ratio: 264 / 548;
    border-radius: 14.6% / 7.04%;
    border: 1px solid rgba(255, 255, 255, 0.55);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.03) 42%, rgba(255, 255, 255, 0.07));
    -webkit-backdrop-filter: blur(3px) saturate(1.4);
    backdrop-filter: blur(3px) saturate(1.4);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.75),
      inset 0 -1px 0 rgba(255, 255, 255, 0.2),
      0 18px 48px rgba(12, 20, 48, 0.3);
  }

  /* The rim: a band of thicker glass just inside the edge, blurring and brightening what is behind it. */
  .phone-rim {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1.9cqw;
    -webkit-backdrop-filter: blur(6px) brightness(1.14);
    backdrop-filter: blur(6px) brightness(1.14);
    background: rgba(255, 255, 255, 0.06);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
  }

  .phone-screen {
    position: absolute;
    inset: 1.9cqw;
    overflow: hidden;
    border-radius: 12.9% / 6.1%;
  }

  .phone-island {
    position: absolute;
    top: 4.4cqw;
    left: 50%;
    width: 31cqw;
    height: 8.6cqw;
    border-radius: 999px;
    background: rgba(10, 10, 12, 0.72);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    transform: translateX(-50%);
  }
</style>
