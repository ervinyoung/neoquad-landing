---
// The seed: the neoQuad mark. Twelve petals, drawn from the Logo Pack artwork.
// `wave` plays the brand's Wave once on first arrival: petals come up in turn from the centre out of
// a faint seed, dim as the ripple passes, and return. Nothing moves. The seed is never absent: a
// busy first load can hold the first frame on screen for seconds, so that frame shows it faint.
import seed from '../data/seed.json';

interface Props {
  wave?: boolean;
  label?: string;
  class?: string;
  [attr: string]: unknown;
}
const { wave = false, label, class: className, ...rest } = Astro.props;
---

<svg
  class:list={['mark', wave && 'mark--wave', className]}
  viewBox={seed.viewBox.join(' ')}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  {...rest}
>
  {seed.petals.map((petal) => <path d={petal.d} style={`--step:${petal.step}`} />)}
</svg>

<script>
  // The Wave plays once. When the last petal has settled, the flag goes and the animations with it:
  // Chromium can drop a shape held by a finished animation from a later repaint, and the seed
  // vanished beside the wordmark.
  const settle = (event: AnimationEvent) => {
    if (!(event.target as Element).closest('.mark--wave')) return;
    const waving = document
      .getAnimations()
      .some((a) => a.playState === 'running' && ((a.effect as KeyframeEffect | null)?.target as Element | null)?.closest('.mark--wave'));
    if (waving) return;
    document.documentElement.removeAttribute('data-first');
    document.removeEventListener('animationend', settle);
  };
  document.addEventListener('animationend', settle);
  // A slow first load has already shown the seed faint for a while; it settles at once instead.
  if (performance.now() > 2500) document.documentElement.removeAttribute('data-first');
</script>

<style>
  .mark {
    overflow: visible;
  }

  .mark path {
    fill: currentColor;
  }

  @keyframes wave-in {
    0% {
      opacity: 0.2;
    }
    30% {
      opacity: 1;
    }
    62% {
      opacity: 0.3;
    }
    100% {
      opacity: 1;
    }
  }

  @keyframes wave-fade {
    from {
      opacity: 0.2;
    }
  }

  /* First arrival only. The nav persists across pages and must not play again. */
  :global(html[data-first]) .mark--wave path {
    animation: wave-in 2200ms cubic-bezier(0.37, 0, 0.63, 1) both;
    animation-delay: calc(140ms + var(--step) * 75ms);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-first]) .mark--wave path {
      animation: wave-fade 200ms ease both;
      animation-delay: 0ms;
    }
  }
</style>
