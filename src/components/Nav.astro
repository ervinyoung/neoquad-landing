---
// One floating glass bar, the same object on every page: the mark, the audience switch, and one door.
// At the top of a page the door is staff sign-in. Past the hero it becomes the page's action.
import Mark from './Mark.astro';
import Lockup from './Lockup.astro';
import Action from './Action.astro';
import { links } from '../config';

interface Props {
  audience: 'students' | 'schools' | 'none';
}
const { audience } = Astro.props;
---

<header class="nav" data-audience={audience} transition:persist="nav">
  <a class="nav-home" href="/" aria-label="neoQuad, home">
    <Mark wave class="nav-mark" />
    <Lockup wave class="nav-lockup" />
  </a>

  <nav class="switch" aria-label="Who are you?">
    <a href="/" data-key="students" aria-current={audience === 'students' ? 'page' : undefined}>Students</a>
    <a href="/schools" data-key="schools" aria-current={audience === 'schools' ? 'page' : undefined}>Schools</a>
    <span class="switch-pill" aria-hidden="true"><span>Students</span><span>Schools</span></span>
  </nav>

  <div class="nav-end">
    <a class="nav-signin" href={links.staff}>Sign in</a>
    <span class="nav-action nav-action--students"><Action to="app" tone="accent" compact /></span>
    <span class="nav-action nav-action--schools"><Action to="booking" tone="accent" compact /></span>
  </div>
</header>

<script>
  // The bar persists across pages, so its state is moved by hand.
  const audienceOf = (pathname: string) => {
    const path = pathname.replace(/\/$/, '');
    return path === '' ? 'students' : path === '/schools' ? 'schools' : 'none';
  };

  const setAudience = (pathname: string) => {
    const nav = document.querySelector<HTMLElement>('.nav');
    if (!nav) return;
    const audience = audienceOf(pathname);
    nav.dataset.audience = audience;
    nav.querySelectorAll<HTMLAnchorElement>('.switch a').forEach((a) => {
      if (a.dataset.key === audience) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
  };

  // Past the hero, the nav carries the page's action.
  let heroWatch: IntersectionObserver | null = null;
  const watchHero = () => {
    heroWatch?.disconnect();
    const nav = document.querySelector<HTMLElement>('.nav');
    const hero = document.querySelector('.hero');
    if (!nav) return;
    if (!hero) return nav.removeAttribute('data-past-hero');
    heroWatch = new IntersectionObserver(([entry]) => nav.toggleAttribute('data-past-hero', !entry.isIntersecting), {
      rootMargin: '-96px 0px 0px 0px',
    });
    heroWatch.observe(hero);
  };

  // The pill starts moving the moment a switch begins, not when the new page lands.
  document.addEventListener('astro:before-preparation', (event) => {
    setAudience(event.to.pathname);
    document.querySelector('.nav')?.removeAttribute('data-past-hero');
  });
  document.addEventListener('astro:page-load', () => {
    setAudience(location.pathname);
    watchHero();
  });
</script>

<style>
  .nav {
    position: fixed;
    z-index: 50;
    top: calc(var(--gutter) + 12px + env(safe-area-inset-top, 0px));
    left: 50%;
    width: min(760px, calc(100% - 2 * (var(--gutter) + 12px)));
    transform: translateX(-50%);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 6px;
    border-radius: 999px;
    color: var(--white);
    background: rgba(24, 24, 26, 0.66);
    -webkit-backdrop-filter: blur(28px) saturate(1.8);
    backdrop-filter: blur(28px) saturate(1.8);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      0 12px 40px rgba(0, 0, 0, 0.2);
    view-transition-name: nav;
  }

  .nav-home {
    justify-self: start;
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 999px;
    transition: opacity 160ms ease;
  }

  .nav-home:active {
    opacity: 0.7;
  }

  .nav-mark {
    height: 30px;
    width: auto;
  }

  .nav-lockup {
    display: none;
    height: 34px;
    width: auto;
  }

  @media (min-width: 700px) {
    .nav-mark {
      display: none;
    }
    .nav-lockup {
      display: block;
    }
    .nav-home {
      padding: 0 16px;
    }
  }

  /* The switch. A white copy of the labels sits on top and is clipped to the active half,
     so the colour of the text changes exactly where the pill is. On pages for neither
     audience the pill closes to nothing. */
  .switch {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: 44px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    font-size: 0.9375rem;
    font-weight: 500;
    user-select: none;
    -webkit-user-select: none;
  }

  .switch a,
  .switch-pill span {
    display: grid;
    place-items: center;
    padding: 0 clamp(14px, 4vw, 22px);
    white-space: nowrap;
  }

  .switch a {
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.86);
    -webkit-touch-callout: none;
    transition: color 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .switch a:hover {
      color: var(--white);
    }
  }

  .switch-pill {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: 999px;
    background: var(--white);
    color: var(--black);
    pointer-events: none;
    clip-path: inset(3px 50% 3px 50% round 999px);
    transition: clip-path 520ms var(--ease-glass);
  }

  .nav[data-audience='students'] .switch-pill {
    clip-path: inset(3px 50% 3px 3px round 999px);
  }

  .nav[data-audience='schools'] .switch-pill {
    clip-path: inset(3px 3px 3px 50% round 999px);
  }

  /* The pill gives a little under the finger before it travels. */
  .nav[data-audience='students'] .switch:active .switch-pill {
    clip-path: inset(4px calc(50% + 1px) 4px 5px round 999px);
    transition-duration: 160ms;
  }

  .nav[data-audience='schools'] .switch:active .switch-pill {
    clip-path: inset(4px 5px 4px calc(50% + 1px) round 999px);
    transition-duration: 160ms;
  }

  /* One cell, two occupants: sign-in at the top of the page, the action once past the hero. */
  .nav-end {
    justify-self: end;
    display: grid;
    justify-items: end;
    align-items: center;
  }

  .nav-end > * {
    grid-area: 1 / 1;
  }

  .nav-signin {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
    user-select: none;
    -webkit-user-select: none;
    transition:
      opacity 260ms ease 60ms,
      filter 260ms ease 60ms,
      transform 160ms var(--ease-out),
      background-color 160ms ease,
      visibility 0s;
  }

  .nav-signin:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-signin:hover {
      background: rgba(255, 255, 255, 0.1);
    }
  }

  .nav-action {
    display: none;
    opacity: 0;
    visibility: hidden;
    filter: blur(4px);
    transform: scale(0.96);
    transition:
      opacity 180ms ease,
      filter 180ms ease,
      transform 180ms var(--ease-out),
      visibility 0s linear 180ms;
  }

  .nav[data-audience='students'] .nav-action--students,
  .nav[data-audience='schools'] .nav-action--schools {
    display: flex;
  }

  .nav[data-past-hero]:not([data-audience='none']) .nav-action {
    opacity: 1;
    visibility: visible;
    filter: none;
    transform: none;
    transition:
      opacity 260ms ease 60ms,
      filter 260ms ease 60ms,
      transform 260ms var(--ease-out) 60ms,
      visibility 0s;
  }

  .nav[data-past-hero]:not([data-audience='none']) .nav-signin {
    opacity: 0;
    visibility: hidden;
    filter: blur(4px);
    transition:
      opacity 180ms ease,
      filter 180ms ease,
      visibility 0s linear 180ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .switch-pill {
      transition: none;
    }
    .nav-action,
    .nav[data-past-hero]:not([data-audience='none']) .nav-action {
      filter: none;
      transform: none;
    }
  }
</style>
