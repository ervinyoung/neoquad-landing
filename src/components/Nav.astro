---
// One floating bar of subtle Liquid Glass, the same object on every page: the mark, the audience
// switch, and the page's action. Its ink turns dark over light sections and light over everything
// else. Nothing in it comes or goes as the page scrolls. Where the bar is wide enough, the staff
// door sits beside the action; on narrower screens staff sign in from the footer.
// The action is clear glass over the first screen and takes the accent after it.
import Mark from './Mark.astro';
import Lockup from './Lockup.astro';
import Action from './Action.astro';
import { links } from '../config';

interface Props {
  audience: 'students' | 'schools' | 'none';
}
const { audience } = Astro.props;
---

<header
  class="nav"
  data-audience={audience}
  data-over="dark"
  data-first-screen={audience !== 'none'}
  transition:persist="nav"
>
  <a class="nav-home" href="/" aria-label="neoQuad, home">
    <Mark wave class="nav-mark" />
    <Lockup wave class="nav-lockup" />
  </a>

  <nav class="switch" aria-label="Who are you?">
    <a href="/" data-key="students" aria-current={audience === 'students' ? 'page' : undefined}>Students</a>
    <a href="/schools" data-key="schools" aria-current={audience === 'schools' ? 'page' : undefined}>Schools</a>
    <span class="switch-pill" aria-hidden="true"><span>Students</span><span>Schools</span></span>
  </nav>

  <div class="nav-end">
    <a class="nav-signin" href={links.staff}>Staff sign in</a>
    <span class="nav-action nav-action--students"><Action to="app" tone="accent" compact /></span>
    <span class="nav-action nav-action--schools"><Action to="booking" tone="accent" compact /></span>
  </div>
</header>

<script>
  // The bar persists across pages, so its state is moved by hand.
  const audienceOf = (pathname: string) => {
    const path = pathname.replace(/\/$/, '');
    return path === '' ? 'students' : path === '/schools' ? 'schools' : 'none';
  };

  const setAudience = (pathname: string) => {
    const nav = document.querySelector<HTMLElement>('.nav');
    if (!nav) return;
    const audience = audienceOf(pathname);
    nav.dataset.audience = audience;
    nav.querySelectorAll<HTMLAnchorElement>('.switch a').forEach((a) => {
      if (a.dataset.key === audience) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
  };

  // While the hero is on screen the action stays clear glass (see .btn--accent in global.css).
  let heroWatch: IntersectionObserver | null = null;
  const watchHero = () => {
    heroWatch?.disconnect();
    const nav = document.querySelector<HTMLElement>('.nav');
    const hero = document.querySelector('.hero');
    if (!nav) return;
    if (!hero) return nav.removeAttribute('data-first-screen');
    heroWatch = new IntersectionObserver(([entry]) => nav.toggleAttribute('data-first-screen', entry.isIntersecting), {
      rootMargin: '-96px 0px 0px 0px',
    });
    heroWatch.observe(hero);
  };

  // The glass takes its tone from what is under it: dark ink over light sections, light ink over
  // photographs and black. One sample per frame at the centre of the bar, only while scrolling.
  let sampling = false;
  const readUnder = () => {
    sampling = false;
    const nav = document.querySelector<HTMLElement>('.nav');
    if (!nav) return;
    const box = nav.getBoundingClientRect();
    const under = document.elementsFromPoint(innerWidth / 2, box.top + box.height / 2).find((el) => !nav.contains(el));
    nav.dataset.over = under?.closest('.section--white, .section--mist') ? 'light' : 'dark';
  };
  const sampleUnder = () => {
    if (sampling) return;
    sampling = true;
    requestAnimationFrame(readUnder);
  };
  addEventListener('scroll', sampleUnder, { passive: true });
  addEventListener('resize', sampleUnder, { passive: true });

  // The pill starts moving the moment a switch begins, not when the new page lands.
  document.addEventListener('astro:before-preparation', (event) => {
    setAudience(event.to.pathname);
    document.querySelector('.nav')?.setAttribute('data-first-screen', '');
  });
  // While a page switch plays, everything hit-tests as the page root, so the bar reads again once
  // the transition has finished (a restored scroll position may have put it over a light section).
  document.addEventListener('astro:before-swap', (event) => {
    event.viewTransition.finished.then(readUnder, readUnder);
  });
  document.addEventListener('astro:page-load', () => {
    setAudience(location.pathname);
    watchHero();
    readUnder();
  });
</script>

<style>
  /* Liquid Glass, kept quiet: mostly clear, a soft blur of what is behind, a thin bright rim.
     Two tints are stacked, one for dark ground and one for light, and the bar fades
     between them as the page moves under it (data-over, set in the script above). */
  .nav {
    --ink: var(--white);
    --pill: var(--white);
    --pill-ink: var(--black);

    position: fixed;
    z-index: 50;
    isolation: isolate;
    top: calc(var(--gutter) + var(--bar-gap) + env(safe-area-inset-top, 0px));
    left: 50%;
    width: min(var(--bar-max, 760px), calc(100% - 2 * (var(--gutter) + var(--bar-gap))));
    transform: translateX(-50%);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: var(--bar-pad);
    border-radius: 999px;
    color: var(--ink);
    /* The blur lives on the bar itself. The bar is a named page-transition layer, and anything
       inside such a layer has nothing behind it to blur. */
    -webkit-backdrop-filter: blur(24px) saturate(1.7);
    backdrop-filter: blur(24px) saturate(1.7);
    transition: color 320ms ease;
    view-transition-name: nav;
  }

  .nav[data-over='light'] {
    --ink: var(--graphite);
    --pill: var(--graphite);
    --pill-ink: var(--white);
  }

  .nav::before,
  .nav::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    transition: opacity 320ms ease;
  }

  /* Over photographs and black: clear glass with a breath of shade, so white ink always holds. */
  .nav::before {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.13), rgba(255, 255, 255, 0.03)), rgba(18, 18, 22, 0.3);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.34),
      inset 0 0 0 1px rgba(255, 255, 255, 0.1),
      inset 0 -1px 0 rgba(255, 255, 255, 0.08),
      0 10px 34px rgba(0, 0, 0, 0.18);
  }

  /* Over white and mist: frosted clear, with a hairline so the edge is still there. */
  .nav::after {
    opacity: 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0.62));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      inset 0 0 0 1px rgba(28, 28, 30, 0.07),
      0 10px 34px rgba(28, 28, 30, 0.1);
  }

  .nav[data-over='light']::before {
    opacity: 0;
  }

  .nav[data-over='light']::after {
    opacity: 1;
  }

  .nav-home {
    justify-self: start;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: var(--control);
    min-height: var(--control);
    padding: 0 12px;
    border-radius: 999px;
    transition: opacity 160ms ease;
  }

  .nav-home:active {
    opacity: 0.6;
  }

  .nav-mark {
    flex: none;
    height: 28px;
    width: auto;
  }

  .nav-lockup {
    display: none;
    height: 34px;
    width: auto;
  }

  @media (min-width: 700px) {
    .nav-mark {
      display: none;
    }
    .nav-lockup {
      display: block;
    }
    .nav-home {
      padding: 0 16px;
    }
  }

  /* The switch. No track: the pill is its only shape. A second copy of the labels sits on top, in
     the pill's colours, clipped to the active half, so the colour of the text changes exactly
     where the pill is. On pages for neither audience the pill closes to nothing. */
  .switch {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: var(--control);
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 500;
    user-select: none;
    -webkit-user-select: none;
  }

  .switch a,
  .switch-pill span {
    display: grid;
    place-items: center;
    padding: 0 clamp(14px, 4vw, 22px);
    white-space: nowrap;
  }

  .switch a {
    border-radius: 999px;
    color: color-mix(in srgb, var(--ink) 72%, transparent);
    -webkit-touch-callout: none;
    transition: color 320ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .switch a:hover {
      color: var(--ink);
    }
  }

  .switch-pill {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: 999px;
    background: var(--pill);
    color: var(--pill-ink);
    pointer-events: none;
    clip-path: inset(3px 50% 3px 50% round 999px);
    transition:
      clip-path 520ms var(--ease-glass),
      background-color 320ms ease,
      color 320ms ease;
  }

  .nav[data-audience='students'] .switch-pill {
    clip-path: inset(3px 50% 3px 3px round 999px);
  }

  .nav[data-audience='schools'] .switch-pill {
    clip-path: inset(3px 3px 3px 50% round 999px);
  }

  /* The pill gives a little under the finger before it travels. */
  .nav[data-audience='students'] .switch:active .switch-pill {
    clip-path: inset(4px calc(50% + 1px) 4px 5px round 999px);
    transition-duration: 160ms, 320ms, 320ms;
  }

  .nav[data-audience='schools'] .switch:active .switch-pill {
    clip-path: inset(4px 5px 4px calc(50% + 1px) round 999px);
    transition-duration: 160ms, 320ms, 320ms;
  }

  .nav-end {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
  }

  /* The staff door needs a wide bar. Below that it is in the footer. Plain text, a step quieter
     than the switch, so the action stays the only strong shape on this side. */
  .nav-signin {
    display: none;
    align-items: center;
    min-height: var(--control);
    padding: 0 14px;
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    color: color-mix(in srgb, var(--ink) 66%, transparent);
    user-select: none;
    -webkit-user-select: none;
    transition: color 320ms ease;
  }

  .nav-signin:active {
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-signin:hover {
      color: var(--ink);
    }
  }

  @media (min-width: 960px) {
    .nav {
      --bar-max: 800px;
    }

    .nav-signin {
      display: flex;
    }
  }

  .nav-action {
    display: none;
  }

  .nav[data-audience='students'] .nav-action--students,
  .nav[data-audience='schools'] .nav-action--schools {
    display: flex;
  }

  /* The smallest phones: everything a little closer, nothing dropped. */
  @media (max-width: 359px) {
    .nav-home {
      padding: 0 6px;
    }

    .switch {
      font-size: 0.875rem;
    }

    .switch a,
    .switch-pill span {
      padding: 0 11px;
    }

    .nav-action :global(.btn--compact) {
      padding: 0 14px;
      font-size: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .switch-pill {
      transition: none;
    }
  }
</style>
