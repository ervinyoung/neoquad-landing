---
// The Liquid Glass sheet over the map at its resting height, as the Events tab fills it
// (neoQuad-ios 5d968ad, Features/Events/EventsScreen.swift, built from Design/Components/Sheet.swift):
//   sheet    floating 5 pt in from the screen, its top 450 pt down (half the screen, less the home
//            indicator), its top corners 26 pt and its foot concentric with the phone's; the system
//            grabber, 36 x 5 pt, 5 pt down. Measured from the render, as the system draws them.
//   header   SheetHeader: "Events" in .title bold beside the 44 pt glass + (New Event), 18 pt down,
//            44 pt tall, 20 pt margins, 10 pt under it
//   now      HappeningNowCard: a 22 pt card 8 pt in and 8 pt down, its rows inset 12 pt; the live
//            dot, "Happening Now" in .title3 bold and the count in .subheadline, 14 pt down
//   rows     ListRow with showsEnd: a 40 pt picture (the category's symbol when there is no photo,
//            a 2.5 pt ring while it is live), 14 pt to the text, 12 pt above and below; the title in
//            .headline, "Place · Until time" in .subheadline, free food's fork.knife on the right
//            (.caption semibold); hairlines between rows start under the text
// The rows are the demo campus's live events (app/sample.ts), the same ones live on the map above.
// Below the rows the sheet runs on to its tab bar. The hero shows only the top of the phone, so
// the sheet fades out just before the stage cuts the device (--device-shown, in widths, set by
// Hero's stage); anywhere else it is drawn whole.
import Symbol from '../Symbol.astro';
import TabBar from './TabBar.astro';
import { categories, clock, happeningNow } from './sample';
---

<div class="sheet">
  <span class="grabber"></span>

  <header class="header">
    <p class="title">Events</p>
    <span class="add"><Symbol name="plus" /></span>
  </header>

  <section class="now">
    <p class="now-head">
      <span class="dot"></span>
      <span class="now-title">Happening Now</span>
      <span class="now-count">{happeningNow.length} events</span>
    </p>
    <ul>
      {
        happeningNow.map((event) => (
          <li class="row">
            <span class="avatar">
              <Symbol name={categories[event.category].symbol} />
            </span>
            <span class="row-text">
              <span class="row-title">{event.title}</span>
              <span class="row-sub">
                {event.at.name} · Until {clock(event.start + event.minutes)}
              </span>
            </span>
            {event.food && <Symbol class="row-food" name="fork.knife" />}
          </li>
        ))
      }
    </ul>
  </section>

  <TabBar />
</div>

<style>
  .sheet {
    --top: calc(450 * var(--pt));
    /* Where the hero's stage cuts the phone, measured from the sheet's top. */
    --cut: calc(var(--device-shown, 3) * 100cqw - var(--top));

    position: absolute;
    top: var(--top);
    left: calc(5 * var(--pt));
    right: calc(5 * var(--pt));
    bottom: calc(5 * var(--pt));
    border-radius: calc(26 * var(--pt) * var(--corner-reach)) calc(26 * var(--pt) * var(--corner-reach))
      calc((var(--pane-radius) - 5 * var(--pt)) * var(--corner-reach)) calc((var(--pane-radius) - 5 * var(--pt)) * var(--corner-reach));
    corner-shape: var(--corner);
    background: var(--tint);
    -webkit-mask: linear-gradient(180deg, #000 calc(var(--cut) - 10cqw), transparent calc(var(--cut) + 2cqw));
    mask: linear-gradient(180deg, #000 calc(var(--cut) - 10cqw), transparent calc(var(--cut) + 2cqw));
  }

  /* Its rim: light along the top, fading down the sides, as the phone's own glass is lit. */
  .sheet::before {
    content: '';
    position: absolute;
    inset: 0;
    border: var(--hair) solid transparent;
    border-radius: inherit;
    corner-shape: inherit;
    background: linear-gradient(180deg, var(--rule-strong), var(--rule) 12%, transparent 40%) border-box;
    -webkit-mask:
      linear-gradient(#000 0 0) padding-box exclude,
      linear-gradient(#000 0 0) border-box;
    mask:
      linear-gradient(#000 0 0) padding-box exclude,
      linear-gradient(#000 0 0) border-box;
  }

  .grabber {
    position: absolute;
    top: calc(5 * var(--pt));
    left: calc(50% - 18 * var(--pt));
    width: calc(36 * var(--pt));
    height: calc(5 * var(--pt));
    border-radius: 999px;
    background: var(--rule);
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: calc(44 * var(--pt));
    margin: calc(18 * var(--pt)) calc(20 * var(--pt)) calc(10 * var(--pt));
  }

  .title {
    font-size: calc(28 * var(--pt));
    font-weight: 700;
    letter-spacing: 0.012em;
    color: var(--ink);
  }

  .add {
    display: grid;
    place-items: center;
    width: calc(44 * var(--pt));
    height: calc(44 * var(--pt));
    border-radius: 50%;
    background: var(--tint);
    box-shadow: inset 0 0 0 var(--hair) var(--rule);
    font-size: calc(19 * var(--pt));
    color: var(--ink);
  }

  /* Happening Now */
  .now {
    margin: calc(8 * var(--pt)) calc(8 * var(--pt)) 0;
    padding-bottom: calc(4 * var(--pt));
    border-radius: calc(22 * var(--pt) * var(--corner-reach));
    corner-shape: var(--corner);
    background: var(--tint);
  }

  .now-head {
    display: flex;
    align-items: center;
    gap: calc(10 * var(--pt));
    padding: calc(14 * var(--pt)) calc(12 * var(--pt)) calc(2 * var(--pt));
  }

  .dot {
    flex: none;
    width: calc(8 * var(--pt));
    height: calc(8 * var(--pt));
    border-radius: 50%;
    background: var(--ink);
  }

  .now-title {
    flex: 1;
    font-size: calc(20 * var(--pt));
    font-weight: 700;
    line-height: calc(25 * var(--pt));
    letter-spacing: 0.019em;
    color: var(--ink);
  }

  .now-count {
    font-size: calc(15 * var(--pt));
    letter-spacing: -0.016em;
    color: var(--ink-2);
  }

  .row {
    display: flex;
    align-items: center;
    gap: calc(14 * var(--pt));
    padding: calc(12 * var(--pt));
  }

  /* The hairline between rows starts under the text. */
  .row + .row {
    background: linear-gradient(var(--rule), var(--rule)) no-repeat calc(66 * var(--pt)) 0 / calc(100% - 78 * var(--pt)) var(--hair);
  }

  .avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: calc(40 * var(--pt));
    height: calc(40 * var(--pt));
    border-radius: 50%;
    box-shadow: inset 0 0 0 calc(2.5 * var(--pt)) var(--rule-strong);
    font-size: calc(16.8 * var(--pt));
    color: var(--ink);
  }

  .row-text {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: calc(2 * var(--pt));
  }

  .row-title,
  .row-sub {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .row-title {
    font-size: calc(17 * var(--pt));
    font-weight: 600;
    line-height: calc(22 * var(--pt));
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  .row-sub {
    font-size: calc(15 * var(--pt));
    line-height: calc(20 * var(--pt));
    letter-spacing: -0.016em;
    color: var(--ink-2);
  }

  .row :global(.row-food) {
    align-self: flex-start;
    margin-top: calc(4 * var(--pt));
    font-size: calc(12 * var(--pt));
    color: var(--ink-2);
  }

  @keyframes sheet-in {
    from {
      opacity: 0;
      translate: 0 calc(12 * var(--pt));
    }
  }

  :global(html[data-enter]) .sheet {
    animation: sheet-in 700ms var(--ease-out) backwards;
    animation-delay: calc(var(--t0, 1200ms) + 200ms);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-enter]) .sheet {
      animation-name: fade-in;
    }

    @keyframes fade-in {
      from {
        opacity: 0;
      }
    }
  }
</style>
