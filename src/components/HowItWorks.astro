---
// How neoQuad works, as one event followed through the app: Student Life posts Club Rush, it lands
// on the campus map, and a student who is going is told to walk over. Each picture is a piece of the
// real app (neoQuad-ios at 5d968ad, the build the App Store screenshots come from; see tools/app_source.py), drawn at its own
// point sizes in a 340 x 400 pt scene; the parts and their sources are listed in each scene.
// The scenes play once as they come into view, left to right where they stand side by side.
// The pictures are aria-hidden; the ordered list of lines carries the meaning.
import NewEvent from './how/NewEvent.astro';
import MapScene from './how/MapScene.astro';
import EventPage from './how/EventPage.astro';

const steps = [
  { line: 'A club posts it.', Scene: NewEvent },
  { line: 'It goes live on the map.', Scene: MapScene },
  { line: 'You walk over.', Scene: EventPage },
];
---

<section class="section section--mist how">
  <div class="wrap">
    <h2 class="line line--section" data-reveal>From the post <i>to the place.</i></h2>

    <ol class="rail steps">
      {
        steps.map(({ line, Scene }, i) => (
          <li class="step" data-reveal style={`--i:${i};--step:${i}`}>
            <div class="scene" aria-hidden="true">
              <Scene />
            </div>
            <p class="line line--small">{line}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how h2 {
    max-width: 12em;
  }

  /* ---------- Layout ----------
     Each line stands under its own picture, so they can never drift apart. The three are a rail
     (global.css): they scroll sideways and snap below 900px, and from there stand in a row and play
     in turn, a beat apart. Each line is one line, the three a set: the type steps down where a
     column is too narrow for the longest ("It goes live on the map." is 10.4 em wide). */

  .steps {
    --beat: 0ms;
  }

  .step {
    --t: calc(300ms + var(--step) * var(--beat));
    container-type: inline-size;
  }

  .step > .line {
    margin-top: 28px;
    font-size: min(var(--line-small), 100cqi / 11.2);
  }

  @media (min-width: 900px) {
    .steps {
      --beat: 850ms;
    }
  }

  /* ---------- The scene ----------
     A piece of the app's screen, 340 pt wide and 400 pt tall, in dark mode as the app always is.
     1 pt is a 340th of the scene, so every size below is the app's own number of points. */

  .scene {
    --pt: calc(100cqw / 340);

    /* iOS dark mode, as the app draws on it */
    --app-label: #ffffff;
    --app-label-2: rgba(235, 235, 245, 0.6);
    --app-separator: rgba(84, 84, 88, 0.6);
    --app-fill: rgba(120, 120, 128, 0.36);
    --app-sheet: #1c1c1e;
    --app-sheet-grouped: #1c1c1e;
    --app-cell: #2c2c2e;
    --app-glass: rgba(255, 255, 255, 0.1);
    --app-map: #232325;
    --app-orange: #ff9f0a;
    /* The app's palette (Design/Palette.swift, Theme.swift): Coastal on dark, Live text on dark,
       and the card fill on dark (white at 7%). */
    --app-coastal: #2d86ec;
    --app-live: #30d158;
    --app-card: rgba(255, 255, 255, 0.07);

    position: relative;
    container-type: inline-size;
    overflow: hidden;
    aspect-ratio: 340 / 400;
    border-radius: calc(var(--window-radius) * var(--corner-reach));
    corner-shape: var(--corner);
    background: var(--app-sheet);
    color: var(--app-label);
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', var(--sans);
    letter-spacing: -0.01em;
    isolation: isolate;
    user-select: none;
    -webkit-user-select: none;
  }
</style>
