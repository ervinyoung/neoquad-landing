---
// The same coast in two lights. Name the scene; everything else is handled here.
//
//   scene="dusk"       The picture leads: the sharp dusk photograph as a living place (swell on the
//                      sea, clouds on the wind, a slow camera; see living-coast.ts), and a progressive
//                      blur rising from the bottom, under the headline. Its map, plate and sky come from
//                      tools/coast-maps.py, which also holds the horizon and the sky's reach given below.
//   scene="blue-hour"  The words lead: the photograph blurred to light and colour, drifting slowly.
//
// Each scene also fetches the other one quietly, so switching pages never lands on an empty window.
// Place it as the first child of a `.window`.
import { Image, getImage } from 'astro:assets';
import dusk from '../assets/photos/dusk.jpg';
import duskSoft from '../assets/photos/dusk-soft.jpg';
import duskSofter from '../assets/photos/dusk-softer.jpg';
import duskMap from '../assets/photos/dusk-map.webp';
import duskPlate from '../assets/photos/dusk-plate.webp';
import duskSky from '../assets/photos/dusk-sky.webp';
import blueHour from '../assets/photos/bluehour-blur.jpg';

interface Props {
  scene: 'dusk' | 'blue-hour';
}
const { scene } = Astro.props;

// The photograph is cropped to cover the window. On a tall screen it is the height that decides how
// wide the picture is drawn (16:9, so 178% of the height), and the browser must be told, or it
// fetches a file sized for the width alone and stretches it.
const duskSizes = { widths: [750, 1200, 1600, 2000, 2400], sizes: 'max(100vw, 178vh)', quality: 78 };
// The first thing painted in the window, in either light: a small copy of the scene's softest
// picture, so it arrives as a whole that sharpens, never as a band filling in from the top. It is
// the window's background, which a browser finds only once the styles apply, so it is also
// preloaded: for the scene shown, and only that one.
const first = await getImage({ src: scene === 'dusk' ? duskSofter : blueHour, width: 400, quality: 60 });
const blueSizes = { widths: [750, 1200, 1920], sizes: '100vw', quality: 70 };
// Progressive blur: two softer copies of the photograph laid over it. Each is whole from an edge of
// the window up to `full` and gone by `end` (fractions of the window's height). The bottom is always
// softened; the top only when a parent sets --coast-soft-top: 1, for words set up there.
// Written once here, and read by both the still picture (CSS masks) and the living one (the shader).
const blur = {
  soft: { bottom: { full: 0.12, end: 0.44 }, top: { full: 0.16, end: 0.48 } },
  softer: { bottom: { full: 0.03, end: 0.28 }, top: { full: 0.1, end: 0.36 } },
};
const pct = (n: number) => `${n * 100}%`;
const blurVars = Object.entries(blur)
  .flatMap(([layer, edges]) =>
    Object.entries(edges).flatMap(([edge, stop]) => [`--${layer}-${edge}-full:${pct(stop.full)}`, `--${layer}-${edge}-end:${pct(stop.end)}`]),
  )
  .join(';');
const lead = { loading: 'eager', fetchpriority: 'high', decoding: 'sync' } as const;
const warm = { loading: 'eager', fetchpriority: 'low', alt: '', class: 'coast-warm' } as const;
---

<link rel="preload" as="image" href={first.src} fetchpriority="high" />
{
  scene === 'dusk' ? (
    <div
      class="coast coast--dusk"
      data-living-coast
      data-map={duskMap.src}
      data-plate={duskPlate.src}
      data-sky={duskSky.src}
      data-sky-reach="0.1"
      data-horizon="0.5426"
      data-blur={JSON.stringify(blur)}
      data-focus-x="0.38"
      data-focus-y="1"
      style={`background-image:url(${first.src});${blurVars}`}
    >
      <Image class="coast-photo" src={dusk} alt="The Santa Barbara coast at dusk, pink sky over dark bluffs" {...duskSizes} {...lead} />
      <Image class="coast-blur coast-blur--soft" src={duskSoft} alt="" widths={[600, 1200]} sizes="100vw" quality={70} loading="eager" />
      <Image class="coast-blur coast-blur--softer" src={duskSofter} alt="" widths={[400, 800]} sizes="100vw" quality={70} loading="eager" />
      <canvas class="coast-live" aria-hidden="true" />
      <Image src={blueHour} {...blueSizes} {...warm} />
    </div>
  ) : (
    <div class="coast coast--blue-hour" style={`background-image:url(${first.src})`}>
      <Image class="coast-photo" src={blueHour} alt="" {...blueSizes} {...lead} />
      <Image src={dusk} {...duskSizes} {...warm} />
    </div>
  )
}

<script>
  import { start, type Stop } from '../scripts/living-coast';

  let stop: Stop | null = null;
  const end = () => {
    stop?.();
    stop = null;
  };

  // The living layer is a finishing touch. It waits until the page has loaded and the browser is
  // idle, and it stays off for visitors who asked to save data.
  const whenQuiet = () =>
    new Promise<void>((resolve) => {
      const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(() => resolve(), { timeout: 1500 }) : setTimeout(resolve, 300));
      if (document.readyState === 'complete') idle();
      else addEventListener('load', idle, { once: true });
    });

  document.addEventListener('astro:page-load', async () => {
    end();
    const root = document.querySelector<HTMLElement>('[data-living-coast]');
    if (!root) return;
    if ((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData) return;
    await whenQuiet();
    if (!root.isConnected) return;
    stop = await start(root).catch(() => null);
  });
  document.addEventListener('astro:before-swap', end);
</script>

<style>
  .coast {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background-position: center;
    background-size: cover;
  }

  .coast :global(img),
  .coast-live {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .coast :global(.coast-warm) {
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  /* Dusk */
  .coast--dusk {
    background-position: 38% 100%;
  }

  .coast--dusk :global(img) {
    object-position: 38% 100%;
  }

  /* The living layer fades in over the still picture once its first frame is drawn. It draws the
     photograph and both blurs itself, so the softened parts move with the rest. */
  .coast-live {
    opacity: 0;
    transition: opacity 1200ms ease;
  }

  .coast-live[data-on] {
    opacity: 1;
  }

  /* Where words stand at the top (--coast-soft-top: 1), the sky also deepens a little behind them,
     as dusk does toward the zenith, so white type keeps its contrast over the brightest pink. It lies
     over the living layer too, and fades out a little below the top blur, past a short window's third line. */
  .coast::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(30, 24, 44, calc(0.34 * var(--coast-soft-top, 0))) var(--soft-top-full),
      rgba(30, 24, 44, 0) calc(var(--soft-top-end) + 8%)
    );
    pointer-events: none;
  }

  /* Progressive blur, bottom up: a light blur reaching to mid-picture, a deep one under the words.
     The stops are the `blur` table above, arriving as custom properties on .coast. */
  .coast :global(.coast-blur) {
    --top: rgba(0, 0, 0, var(--coast-soft-top, 0));
    -webkit-mask-image:
      linear-gradient(to top, #000 var(--full-b), transparent var(--end-b)),
      linear-gradient(to bottom, var(--top) var(--full-t), transparent var(--end-t));
    mask-image:
      linear-gradient(to top, #000 var(--full-b), transparent var(--end-b)),
      linear-gradient(to bottom, var(--top) var(--full-t), transparent var(--end-t));
  }

  .coast :global(.coast-blur--soft) {
    --full-b: var(--soft-bottom-full);
    --end-b: var(--soft-bottom-end);
    --full-t: var(--soft-top-full);
    --end-t: var(--soft-top-end);
  }

  .coast :global(.coast-blur--softer) {
    --full-b: var(--softer-bottom-full);
    --end-b: var(--softer-bottom-end);
    --full-t: var(--softer-top-full);
    --end-t: var(--softer-top-end);
  }

  /* Blue hour: only light and colour, so the camera alone moves, on the same slow periods as the dusk
     camera (living-coast.ts): a push breathing over 97s, a drift over 71s. Different periods, so the
     two never turn back together. Reduce Motion keeps only the push. */
  .coast--blue-hour :global(.coast-photo) {
    inset: -4%;
    width: 108%;
    height: 108%;
    animation:
      drift 35.5s ease-in-out infinite alternate,
      push 48.5s ease-in-out infinite alternate;
  }

  @keyframes drift {
    from {
      translate: -1.6% 1% 0;
    }
    to {
      translate: 1.6% -1% 0;
    }
  }

  @keyframes push {
    from {
      scale: 1;
    }
    to {
      scale: 1.05;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coast--blue-hour :global(.coast-photo) {
      animation: push 72s ease-in-out infinite alternate;
    }
  }
</style>
