---
// The first screen: one photograph, one line, one way in.
//
//   scene   which light the coast is in ("dusk" or "blue-hour")
//   line    the headline, in parts: strings, { i: 'italic' } for the second thought, 'br' to break
//   calm    set the line a size down, for a longer sentence
//   <slot>  the action
//   <slot name="device">  optional: something to stand on the photograph, a GlassPhone or a GlassWindow
//   device  its shape, "phone" (the default) or "window"; it sets how the stage frames it
//
// The headline arrives word by word; the action follows once the last word has landed.
//
// Two layouts, chosen here and nowhere else:
//   - Default: the line bottom left, the action bottom right.
//   - Stage (when a device is given): the device rises out of the bottom edge. On phones and tall
//     windows the line is centred above it and the action is one wide button pinned beneath it;
//     on wide windows the line and its action hold the bottom left and the device stands to the
//     right. A phone stands whole in its half; a window is larger and runs off the right edge.
import Coast from './Coast.astro';
import Words from './Words.astro';

type Part = string | { i: string };
interface Props {
  scene: 'dusk' | 'blue-hour';
  line: Part[];
  calm?: boolean;
  device?: 'phone' | 'window';
}
const { scene, line, calm = false, device = 'phone' } = Astro.props;

const words = line
  .filter((part) => part !== 'br')
  .flatMap((part) => (typeof part === 'string' ? part : part.i).split(' '))
  .filter(Boolean).length;
// Matches the word timing in global.css: 320ms lead, 85ms a word.
const actionDelay = 320 + words * 85 + 220;
const staged = Astro.slots.has('device');
---

<section class:list={['hero', `hero--${scene}`, calm && 'hero--calm', staged && ['hero--stage', `hero--${device}`]]}>
  <div class="window hero-window">
    <Coast scene={scene} />
    {staged && <div class="hero-device" style={`--t0:${actionDelay - 300}ms`}><slot name="device" /></div>}
    <div class="hero-copy">
      <h1 class="line hero-line"><Words parts={line} /></h1>
      <div class="hero-action" data-arrive style={`--d:${actionDelay}ms`}><slot /></div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--gutter);
  }

  /* Named for the page switch (the coast, global.css): the photograph and everything standing on
     it change as one layer. A named element is a backdrop root, so the glass must share its layer
     with the photograph it frosts; given a layer of its own, it would show clear for the switch. */
  .hero-window {
    view-transition-name: coast;
    display: flex;
    align-items: flex-end;
    min-height: calc(100svh - 2 * var(--gutter));
    padding: calc(var(--margin) - var(--gutter));
    padding-top: 120px;
    padding-bottom: max(calc(var(--margin) - var(--gutter)), env(safe-area-inset-bottom, 0px));
  }

  /* The colour the window holds before its photograph has loaded. */
  .hero--dusk .hero-window {
    background: #8f7f86;
  }

  .hero--blue-hour .hero-window {
    background: #2b3a54;
  }

  .hero-copy {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: clamp(28px, 4vw, 48px);
    width: 100%;
  }

  /* Named for the page switch (see global.css). The name is on the line, not on the block that
     also holds the action: a named element is drawn on its own layer, and a glass button inside
     one has nothing behind it to blur. */
  .hero-line {
    view-transition-name: hero-copy;
    font-size: clamp(2.75rem, 1.4rem + 6.2vw, 6.75rem);
    text-shadow: 0 1px 32px rgba(0, 0, 0, 0.22);
  }

  .hero--calm .hero-line {
    max-width: 12.5em;
    font-size: clamp(2.25rem, 1.3rem + 4.1vw, 5rem);
    line-height: 1.06;
  }

  .hero-action {
    display: flex;
    margin-bottom: 0.4rem;
  }

  /* From tablet width up the line wraps, never the layout: the action holds the bottom right. */
  @media (min-width: 700px) {
    .hero-copy {
      flex-wrap: nowrap;
    }

    .hero-line {
      flex: 1;
      min-width: 0;
    }

    .hero-action {
      flex: none;
    }
  }

  /* ---------- Stage: the device stands on the photograph ----------
     One system, two arrangements. The device is placed by four values and the arrangements only
     set them: its width, how much of it shows (in widths), where its left edge is, and the line it
     stands on (it continues below that line, out of sight). */
  .hero-device {
    display: none;
  }

  .hero--stage .hero-device {
    display: block;
    position: absolute;
    left: var(--device-left);
    top: calc(100% - var(--device-floor) - var(--device-shown) * var(--device-width));
    width: var(--device-width);
  }

  .hero--stage .hero-copy {
    position: relative;
    z-index: 1;
  }

  /* The device rises out of the bottom edge as the headline lands. It is glass, so it fades by
     --presence (GlassPane), never by opacity: its frost is live from the first frame it shows.
     After a page switch it waits until the photograph has resolved (900ms, global.css). */
  @keyframes device-rise {
    from {
      --presence: 0;
      transform: translateY(34%);
    }
  }

  @keyframes device-fade {
    from {
      --presence: 0;
    }
  }

  :global(html[data-enter]) .hero--stage .hero-device {
    animation: device-rise 1400ms var(--ease-glass) backwards;
    animation-delay: calc(var(--t0) - 420ms);
  }

  :global(html[data-enter='switch']) .hero--stage .hero-device {
    animation-delay: max(calc(var(--t0) - 420ms), 900ms);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-enter]) .hero--stage .hero-device {
      animation-name: device-fade;
      animation-duration: 800ms;
    }
  }

  /* Phones held upright, and any window taller than it is wide: the line centred at the top, the device rising
     from the bottom edge, and the action as one wide button pinned beneath it, mirroring the bar
     at the top; the device runs on behind it. On a short window the device gets smaller,
     never closer to the headline. */
  @media (max-width: 699px) and (max-aspect-ratio: 4/3), (max-aspect-ratio: 5/6) {
    .hero--stage {
      /* The photograph softens under the line at the top as well as under the action. */
      --coast-soft-top: 1;
      --line-top: 104px;
      --line-size: clamp(2.5rem, 1.1rem + 7.4vw, 4.5rem);
      --action-height: calc(var(--control) + 2 * var(--bar-pad));
      --device-shown: 1.42;
      --device-room: calc(
        100svh - 2 * var(--gutter) - var(--line-top) - env(safe-area-inset-top, 0px) - var(--line-lines, 3.12) * var(--line-size) - 28px -
          var(--action-height) - var(--bar-gap)
      );
      --device-width: clamp(168px, calc(var(--device-room) / var(--device-shown)), min(84vw, 400px));
      --device-left: calc(50% - var(--device-width) / 2);
      --device-floor: calc(var(--action-height) + var(--bar-gap));
    }

    /* A longer sentence, a size down, over more lines. */
    .hero--stage.hero--calm {
      --line-size: clamp(2.125rem, 0.9rem + 6vw, 3.75rem);
      --line-lines: 4.4;
    }

    /* A window is wide, so here it is drawn larger than the screen and runs off the right edge:
       its sidebar and first cards stay big enough to read. */
    .hero--stage.hero--window {
      --device-shown: 0.6;
      --device-width: clamp(520px, calc(var(--device-room) / var(--device-shown)), 170vw);
      --device-left: max(var(--bar-gap), 6vw);
    }

    .hero--stage .hero-window {
      align-items: stretch;
      padding: 0;
    }

    .hero--stage .hero-copy {
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      gap: 0;
      padding: calc(var(--line-top) + env(safe-area-inset-top, 0px)) var(--bar-gap) max(var(--bar-gap), env(safe-area-inset-bottom, 0px));
      text-align: center;
    }

    .hero--stage .hero-line {
      flex: none;
      padding-inline: 8px;
      font-size: var(--line-size);
      text-shadow:
        0 1px 2px rgba(30, 24, 44, 0.18),
        0 2px 28px rgba(30, 24, 44, 0.34);
    }

    .hero--stage .hero-action {
      margin: auto 0 0;
    }

    /* One wide button, as tall as the bar at the top and the same distance from the window's
       edge, so both sit true in its corners. It lies over the device, so its glass is thicker. */
    .hero--stage .hero-action :global(.btn) {
      --glass-top: rgba(255, 255, 255, 0.38);
      --glass-bottom: rgba(255, 255, 255, 0.18);
      flex: 1;
      min-height: var(--action-height);
      font-size: 1.125rem;
      -webkit-backdrop-filter: blur(28px) saturate(1.7) brightness(0.92);
      backdrop-filter: blur(28px) saturate(1.7) brightness(0.92);
    }
  }

  /* Wider windows: the words hold the bottom left, the line over its action, and the device stands
     in the right half, rising out of the window's bottom edge. Its size comes from the window's
     height, within what the width allows. A phone on its side is one of these too, however narrow
     (a stack would not fit its height); on so short a window the device gets smaller,
     down to the phone layout's smallest, rather than running up under the bar. */
  @media (min-width: 700px) and (min-aspect-ratio: 5/6), (min-aspect-ratio: 4/3) {
    .hero--stage {
      --device-shown: 1.6;
      --device-room: calc(100svh - 2 * var(--gutter) - 128px);
      --device-width: clamp(168px, calc(var(--device-room) / var(--device-shown)), min(36vw, 540px));
      --device-left: calc(75% - var(--device-width) / 2);
      --device-floor: 0px;
    }

    /* A window stands larger, from just short of the middle, and just meets the right edge, its map
       tile still in view. Like the phone, on a short window it gets smaller rather than running up
       under the bar: its floor gives way to the room there is. */
    .hero--stage.hero--window {
      --device-shown: 0.58;
      --device-width: clamp(
        min(520px, var(--device-room) / var(--device-shown)),
        calc(var(--device-room) / var(--device-shown)),
        58vw
      );
      --device-left: 45%;
    }

    .hero--stage .hero-copy {
      flex-direction: column;
      align-items: flex-start;
      gap: clamp(24px, 2.4vw, 36px);
      width: calc(var(--device-left) - var(--margin));
    }

    .hero--stage .hero-line {
      flex: none;
      width: 100%;
      font-size: clamp(2.75rem, 0.9rem + 5.1vw, 6.5rem);
    }

    .hero--stage.hero--calm .hero-line {
      font-size: clamp(2.125rem, 4.2vw - 0.2rem, 4.75rem);
    }
  }
</style>
