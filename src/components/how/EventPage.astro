---
// You walk over: Club Rush's page once you are going, eight minutes before it starts (how/story.ts)
// (neoQuad-ios 5d968ad, Features/Events/EventDetailScreen.swift):
//   DetailPage   20 pt margins, 22 pt down, the close button (xmark, 19 pt medium, a 44 pt glass
//                circle) 16 pt down and 20 pt in; 14 pt between blocks
//   DetailTitle  the name (title, bold), then plain lines (body, 3 pt apart): the place, the day and
//                times (EventFormat.when), and Free food (fork.knife, EventTag.food: orange)
//   TrackerCard  (Features/Events/EventTracker.swift) an InfoCard, 22 pt corners on the card fill:
//                a 30 pt IconCircle (checkmark, Coastal), "Time to Head Over" (headline) over
//                "Starts in 8 min. Walk over now." (subheadline, secondary); then the five stages as
//                6 pt capsules 4 pt apart, the current one's label semibold
//   EventPicture the event's picture, 22 pt corners, running on past the scene's edge
// Playing: the tracker fills stage by stage to Head Over, each on the app's linear 0.6 s.
// The event, its place, times and picture are the demo campus's (app/sample.ts).
// Sizes are in --pt, set by the scene.
import { Image } from 'astro:assets';
import Symbol from '../Symbol.astro';
import { clock, photo } from '../app/sample';
import { clubRush, moment } from './story';

const away = clubRush.start - moment;
// EventCountdown: Head Over is the last fifteen minutes, and this far through it.
const stages = ['Going', 'Today', 'Soon', 'Head Over', 'Live'];
const current = 3;
const progress = 1 - (away * 60) / 900;
const fill = (i: number) => (i < current ? 1 : i === current ? Math.max(progress, 0.12) : 0);
---

<div class="page">
  <span class="close"><Symbol name="xmark" /></span>

  <div class="title">
    <b>{clubRush.title}</b>
    <span>{clubRush.at.name}</span>
    <span>Today, {clock(clubRush.start)} – {clock(clubRush.start + clubRush.minutes)}</span>
    {clubRush.food && <span class="food"><Symbol name="fork.knife" /> Free food</span>}
  </div>

  <div class="card">
    <span class="icon"><Symbol name="checkmark" /></span>
    <span class="card-text">
      <b>Time to Head Over</b>
      <span>Starts in {away} min. Walk over now.</span>
    </span>
    <span class="segments">
      {stages.map((_, i) => <span class="segment" style={`--fill:${fill(i)};--n:${i}`} />)}
    </span>
    <span class="labels">
      {stages.map((stage, i) => <span class:list={[i === current && 'current']}>{stage}</span>)}
    </span>
  </div>

  <Image class="picture" src={photo(clubRush.image!)} alt="" widths={[480, 900]} sizes="(min-width: 900px) 30vw, 80vw" />
</div>

<style>
  .page {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: calc(14 * var(--pt));
    padding: calc(22 * var(--pt)) calc(20 * var(--pt)) 0;
    background: var(--app-sheet);
  }

  .close {
    position: absolute;
    top: calc(16 * var(--pt));
    right: calc(20 * var(--pt));
    display: grid;
    place-items: center;
    width: calc(44 * var(--pt));
    height: calc(44 * var(--pt));
    border-radius: 50%;
    background: var(--app-glass);
    box-shadow: inset 0 0 0 calc(0.5 * var(--pt)) rgba(255, 255, 255, 0.12);
    font-size: calc(19 * var(--pt));
  }

  .title {
    display: grid;
    gap: calc(3 * var(--pt));
    padding-bottom: calc(6 * var(--pt));
    font-size: calc(17 * var(--pt));
    line-height: calc(22 * var(--pt));
  }

  .title b {
    padding: 0 calc(56 * var(--pt)) calc(4 * var(--pt)) 0;
    font-size: calc(28 * var(--pt));
    font-weight: 700;
    line-height: calc(34 * var(--pt));
  }

  .food {
    display: flex;
    align-items: center;
    gap: calc(7 * var(--pt));
    color: var(--app-orange);
  }

  /* ---------- TrackerCard ---------- */

  .card {
    display: grid;
    padding: calc(16 * var(--pt));
    border-radius: calc(22 * var(--pt) * var(--corner-reach));
    corner-shape: var(--corner);
    background: var(--app-card);
  }

  .icon {
    display: grid;
    place-items: center;
    width: calc(30 * var(--pt));
    height: calc(30 * var(--pt));
    border-radius: 50%;
    background: var(--app-coastal);
    font-size: calc(15 * var(--pt));
  }

  .card-text {
    display: grid;
    gap: calc(2 * var(--pt));
    margin-top: calc(10 * var(--pt));
    font-size: calc(15 * var(--pt));
    line-height: calc(20 * var(--pt));
    color: var(--app-label-2);
  }

  .card-text b {
    color: var(--app-label);
    font-size: calc(17 * var(--pt));
    font-weight: 600;
    line-height: calc(22 * var(--pt));
  }

  .segments,
  .labels {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: calc(4 * var(--pt));
  }

  .segments {
    margin-top: calc(16 * var(--pt));
  }

  .segment {
    position: relative;
    height: calc(6 * var(--pt));
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
  }

  /* The fill slides in from the left rather than growing, so its rounded end reads as a bar's. */
  .segment::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--app-coastal);
    transform: translateX(calc((var(--fill) - 1) * 100%));
  }

  .labels {
    margin-top: calc(8 * var(--pt));
    color: var(--app-label-2);
    font-size: calc(11 * var(--pt));
    line-height: calc(13 * var(--pt));
    white-space: nowrap;
  }

  /* The labels may shrink to 0.8 to fit their column (minimumScaleFactor). The scene is narrower
     than a phone, so "Head Over" does: to 0.86, measured in SF Pro at 11 pt semibold. */
  .labels .current {
    color: var(--app-label);
    font-size: calc(11 * 0.86 * var(--pt));
    font-weight: 600;
  }

  .picture {
    flex: none;
    width: 100%;
    aspect-ratio: 1400 / 942;
    border-radius: calc(22 * var(--pt) * var(--corner-reach));
    corner-shape: var(--corner);
    object-fit: cover;
  }

  /* ---------- Playing it: stage by stage, each on the app's linear 0.6 s ---------- */

  :global(html.js) .segment::after {
    transform: translateX(-100%);
    transition: transform 600ms linear;
    transition-delay: calc(var(--t) + var(--n) * 600ms);
  }

  :global(html.js .is-in) .segment::after {
    transform: translateX(calc((var(--fill) - 1) * 100%));
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .segment::after {
      transition: none;
    }
  }
</style>
